# Email delivery - add ONE of these options to send OTP to user's inbox

# Option 1: Resend (recommended - free tier, no SMTP setup)
# Get API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=LearnEasy <onboarding@resend.dev>

# Option 2: SMTP (Gmail, Outlook, etc.)
# For Gmail: use App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=LearnEasy <your-email@gmail.com>
